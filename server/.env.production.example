# Copy to .env on the server, then: php artisan key:generate
APP_NAME="Farm Empire"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.nongtrai.io.vn

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nongtrai
DB_USERNAME=nongtrai
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Farm Empire
CORS_ALLOWED_ORIGINS=https://nongtrai.io.vn,https://www.nongtrai.io.vn
# keep 127.0.0.1; set * only if a CDN/proxy (e.g. Hostinger CDN) sits in front of the API
TRUSTED_PROXIES=127.0.0.1
# Only needed when shared/ is not next to this folder
# GAME_ECONOMY_PATH=/var/www/nongtrai/shared/economy.json
GAME_HARVEST_GRACE_MS=2000
# Sign in with Google: OAuth client id (same as VITE_GOOGLE_CLIENT_ID). Empty = disabled.
GOOGLE_CLIENT_ID=
